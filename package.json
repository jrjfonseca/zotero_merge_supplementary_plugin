{
  "name": "zotero-merge-supplementary-pdf",
  "type": "module",
  "version": "0.4.0",
  "description": "Fetch supplementary information for Zotero items from any publisher, convert Word files to PDF, and merge it into the main PDF",
  "config": {
    "addonName": "Merge Supplementary PDF",
    "addonID": "merge-supplementary-pdf@joaofonseca.dev",
    "addonRef": "mergesupppdf",
    "addonInstance": "MergeSupplementaryPDF",
    "prefsPrefix": "extensions.zotero.mergesupppdf"
  },
  "author": "Joao Fonseca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrjfonseca/zotero_merge_supplementary_plugin.git"
  },
  "homepage": "https://github.com/jrjfonseca/zotero_merge_supplementary_plugin#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "release": "zotero-plugin release",
    "test": "node --import ./test/register.mjs --test \"test/*.test.ts\"",
    "test:zotero": "zotero-plugin test",
    "try-fetch": "node --import ./test/register.mjs scripts/try-fetch.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "zotero-plugin-toolkit": "^5.1.4"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "linkedom": "^0.18.13",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}
